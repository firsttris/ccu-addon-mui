#!/bin/sh
#
# Installs or updates the add-on. OpenCCU runs this right after the upload
# and only reboots when it exits with 10 (/bin/install_addon, patch
# 0040-WebUI-AddonInstallNoReboot), so the server is (re)started and
# lighttpd reloaded here; the eQ-3 CCU3 firmware reboots after every add-on
# install anyway. An exit code other than 0 and 10 shows "Error (n)".
#
# A step that fails (e.g. a full /usr/local) ends the install with its code,
# instead of reporting success over a half copied add-on.
set -e

ADDON_DIR=/usr/local/addons/mui
RC_DIR=/usr/local/etc/config/rc.d
WWW_DIR=/usr/local/etc/config/addons/www
LIGHTTPD_DIR=/usr/local/etc/config/lighttpd

# openccu-lite: a LITE= line in /VERSION or occulited installed (never
# VARIANT=lite; ccu-addon-howto docs/11-openccu-lite.md). Its own package
# carries the server built for it and openccu-lite.json.
if grep -q '^LITE=' /VERSION 2>/dev/null || [ -x /usr/bin/occulited ]; then
  [ -f openccu-lite.json ] || exit 2
  case "$(uname -m)" in
    aarch64|arm64) ARCH=arm64 ;;
    x86_64|amd64) ARCH=amd64 ;;
    *) exit 2 ;;
  esac
  BINARY=go-server/ccu-addon-mui-server-lite-$ARCH
  [ -f "$BINARY" ] || exit 2
  umask 022
  # The add-on's data directory: older images fail the unit without it
  mkdir -p $ADDON_DIR/go-server $ADDON_DIR/etc $RC_DIR $WWW_DIR /usr/local/etc/config/addons/mui /usr/local/etc/config/nav.d
  rm -rf $ADDON_DIR/assets
  cp -R dist/. $ADDON_DIR/
  [ -f VERSION ] && cp VERSION $ADDON_DIR/
  cp "$BINARY" $ADDON_DIR/go-server/ccu-addon-mui-server.new
  mv -f $ADDON_DIR/go-server/ccu-addon-mui-server.new $ADDON_DIR/go-server/ccu-addon-mui-server
  chmod 755 $ADDON_DIR/go-server/ccu-addon-mui-server
  cp rc.d/mui-lite $RC_DIR/mui
  chmod 755 $RC_DIR/mui
  # occulited checks the fragment and copies it to lighttpd's directory
  cp lite/lighttpd.conf $ADDON_DIR/etc/lighttpd.conf
  # The entry in openccu-lite's menu
  cp lite/nav.json /usr/local/etc/config/nav.d/mui.json
  [ -L $WWW_DIR/mui ] || ln -sf $ADDON_DIR $WWW_DIR/mui
  sync
  # Started in its unit right away (docs/12-porting-to-openccu-lite.md,
  # step 2); occulited gives the directories to the add-on's user first
  systemctl restart addon-mui.service 2>/dev/null || true
  exit 0
fi

# The server is a static Go binary. mui-<version>-arm-ccu3-raspi.tar.gz
# carries the ARMv7 one for the CCU3 and every Raspberry Pi (a 64-bit ARM
# kernel runs it too), mui-<version>-x86_64-pc.tar.gz the amd64 one for
# OpenCCU on x86 (OVA, Docker, LXC). The wrong archive ends with "Error (2)" in the WebUI.
case "$(uname -m)" in
  armv7*|armv8*|aarch64|arm64) ARCH=arm ;;
  x86_64|amd64) ARCH=amd64 ;;
  *) exit 2 ;;
esac
BINARY=go-server/ccu-addon-mui-server-$ARCH
[ -f "$BINARY" ] || exit 2

# A separate partition on the CCU; on OpenCCU in Docker or LXC /usr/local
# is a plain directory and mount fails, which is fine
if ! mount | grep -q " /usr/local "; then
  mount /usr/local 2>/dev/null || true
fi

# The archive's file modes are not trusted (tar keeps them on the eQ-3
# firmware): everything installed is owned by root and only writable by it
umask 022

mkdir -p $ADDON_DIR/go-server $RC_DIR $WWW_DIR $LIGHTTPD_DIR

# The app: Vite names its files by content hash, so the old ones are
# removed instead of piling up with every update (also the service
# worker's workbox-<hash>.js next to sw.js)
rm -rf $ADDON_DIR/assets
rm -f $ADDON_DIR/workbox-*.js
cp -R dist/. $ADDON_DIR/
cp update-check.cgi $ADDON_DIR/update-check.cgi
[ -f VERSION ] && cp VERSION $ADDON_DIR/

# Leftovers of the old Node.js server
rm -rf $ADDON_DIR/node $ADDON_DIR/server

# Copied next to the running binary and renamed over it: writing into a
# running binary fails ("Text file busy")
cp "$BINARY" $ADDON_DIR/go-server/ccu-addon-mui-server.new
mv -f $ADDON_DIR/go-server/ccu-addon-mui-server.new $ADDON_DIR/go-server/ccu-addon-mui-server
cp rc.d/mui $RC_DIR/mui
cp lighttpd.conf $LIGHTTPD_DIR/mui.conf

# Not every file system knows owners (VFAT on some setups)
chown -R root:root $ADDON_DIR $RC_DIR/mui $LIGHTTPD_DIR/mui.conf 2>/dev/null || true
chmod -R u=rwX,go=rX $ADDON_DIR
chmod 644 $LIGHTTPD_DIR/mui.conf
chmod 755 $ADDON_DIR/update-check.cgi $ADDON_DIR/go-server/ccu-addon-mui-server $RC_DIR/mui

if [ ! -L $WWW_DIR/mui ]; then
  ln -sf $ADDON_DIR $WWW_DIR/mui
fi

sync

# Let lighttpd pick up mui.conf (the proxy for /ws/mui): reload is a
# graceful restart, running requests finish
if [ -x /etc/init.d/S50lighttpd ]; then
  # The add-on is installed by now; without the reload the proxy follows
  # on the next restart
  /etc/init.d/S50lighttpd reload || true
fi

# (Re)start the server a little later, in the background: an update
# installed from the app itself goes through the server, which first
# passes on the WebUI's answer
(sleep 3; $RC_DIR/mui restart) </dev/null >/dev/null 2>&1 &

exit 0
