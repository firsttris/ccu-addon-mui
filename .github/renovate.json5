// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what MUI builds on, plus the "Dependency Dashboard" issue listing what is open. Their own pull
// requests: the openccu-lite release every release of ours is tested against (release.yml), the Go
// toolchain of the server (go directive in go-server/go.mod, which every workflow reads through
// go-version-file) with the staticcheck that has to know that Go, and Bun (packageManager in
// package.json, which CI installs) with its types. The Playwright image follows the lockfile.
// OpenCCU/OpenCCU-Base are read from checkouts by scripts/import-*.mjs, nothing pins them.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // The openccu-lite of the release's lite-vm job and the version docs/tests.md names, as the
      // switch to a fixed release (#259) changed them
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/release\\.yml$/", "/^docs/tests\\.md$/"],
      matchStrings: [
        "lite-release: v(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[a-z]+\\.\\d+)?)\\n",
        "festgelegte openccu-lite \\(zurzeit (?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[a-z]+\\.\\d+)?);",
      ],
      depNameTemplate: "hobbyquaker/openccu-lite",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      // staticcheck of go-unit-tests.yml (`go run ...staticcheck@vX.Y.Z`)
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/go-unit-tests\\.yml$/"],
      matchStrings: ["honnef\\.co/go/tools/cmd/staticcheck@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "honnef.co/go/tools",
      datasourceTemplate: "go",
    },
    {
      // "packageManager": "bun@x.y.z": the Bun of every CI job (bun-version-file, and the
      // npm-installed Bun of the jobs in the Playwright image)
      customType: "regex",
      managerFilePatterns: ["/^package\\.json$/"],
      matchStrings: ['"packageManager": "bun@(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: "oven-sh/bun",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^bun-v(?<version>.+)$",
    },
  ],
  packageRules: [
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      enabled: true,
      rangeStrategy: "bump",
    },
    {
      // openccu-lite has only pre-releases so far: betas and release candidates count (and 1.0.0
      // once it is out), the nightly -dev.N builds do not match and are left out
      matchPackageNames: ["hobbyquaker/openccu-lite"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>(?:beta|rc)\\.\\d+))?$",
      ignoreUnstable: false,
      respectLatest: false,
      groupName: "openccu-lite",
      sourceUrl: "https://github.com/hobbyquaker/openccu-lite",
      commitMessageTopic: "openccu-lite",
      prBodyNotes: [
        "This is the openccu-lite every release of MUI must pass in the `lite-vm` job; the checks of this PR do **not** boot it (`lite-vm.yml` runs on PRs only for the lite paths, and then against the newest release). Before merging: `gh workflow run lite-vm.yml --ref <this branch> -f lite-release=v<new>` and wait for it to be green (from beta.4 on, the heating group's event stopped coming back, #259). Read the release notes and occulited's `docs/` (meta-api, system-api, manifest-format, lite-rpc-methods.json) for changes MUI talks to; `docs/tests.md` names the version too.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Go: the go directive and staticcheck in one PR, a new Go needs a staticcheck that knows it
      matchPackageNames: ["go", "golang", "honnef.co/go/tools"],
      groupName: "Go",
      sourceUrl: "https://github.com/golang/go",
      prBodyNotes: [
        "Every workflow takes Go from `go-version-file: go-server/go.mod`. Check that `go-unit-tests.yml` (staticcheck for both builds) and `build.yml` (static cross builds: linux/arm GOARM=7 for the CCU3, amd64, lite arm64/amd64) stay green. For a new minor: README.md and README.en.md name the minimum Go (\"Go 1.27+\").",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Bun: packageManager and the types in one PR
      matchPackageNames: ["oven-sh/bun", "@types/bun"],
      enabled: true,
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "`packageManager` in package.json is the Bun of every CI job (`bun-version-file` of setup-bun, and `npm install --global bun@…` in the Playwright image) and `@types/bun` moves with it. Bun installs the packages (`bun.lock`), runs the scripts and runs `vite build` and Vitest (`bun --bun`), so the add-on archives of `build.yml` are built with it: read the release notes for `bun install`, `bun run` (pre/post scripts) and Node compatibility, and run `bun install` locally if `bun.lock` changes.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
  ],
}
