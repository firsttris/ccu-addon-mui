# CCU3 Configuration
CCU_HOST=192.168.178.26
CCU_USER=Admin
CCU_PASS=your-password-here

# Callback Host - IP address where CCU can reach this server
# Important: Must be the IP of the machine running this server!
CALLBACK_HOST=192.168.178.134

# Debug Mode
DEBUG=false

# Optional: Override default ports
# WS_PORT=8088
# WS_BIND_HOST=127.0.0.1

# Login with a CCU WebUI user (ccu) or no login at all (none)
# AUTH_MODE=ccu
# RPC_SERVER_PORT=9099
# From the LAN (on the CCU itself the services' own ports are used)
# RPC_PORT=2001
# HMIP_PORT=2010
# VIRTUAL_DEVICES_PORT=9292
# REGA_PORT=8181
